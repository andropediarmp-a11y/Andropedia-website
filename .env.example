# Copy to .env (never commit .env). See docs/BACKEND_PRD.md section 2.7.1.

# --- Recruitment: Google Sheets API ---
# Create a service account in Google Cloud, enable the Sheets API, then share the
# sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor. Row 1 of the tab must hold the
# 11 headers: reference,submitted_at,name,email,year,domain,skills,motivation,portfolio_url,consent,email_status
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
RECRUITMENT_SHEET_ID=
RECRUITMENT_SHEET_TAB=Applications

# --- Recruitment: confirmation email (SMTP) ---
# Gmail: SMTP_HOST=smtp.gmail.com, use an App Password (never the account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Andropedia <club-address@example.com>"
EMAIL_REPLY_TO=

# --- Login ---
# Secret used to hash emailed login codes. REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Database (Supabase Postgres via Prisma) ---
# Supabase dashboard -> Connect. DATABASE_URL is the app's runtime connection: use the
# pooled "Transaction pooler" string (port 6543) and append ?pgbouncer=true&connection_limit=1
# DIRECT_URL is the direct/session string (port 5432), used only for migrations.
DATABASE_URL=
DIRECT_URL=
