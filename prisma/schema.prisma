// This is the Prisma schema file for Andropedia.
// Compatible with PostgreSQL (Supabase, Neon, Railway, or local Postgres)

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MEMBER
  DOMAIN_ADMIN
  SUPER_ADMIN
}

enum Domain {
  TECHNICAL
  WEB
  PR
  RD
  DESIGN
  MEDIA
}

enum TaskStatus {
  SUBMITTED
  EVALUATED
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  role            Role           @default(MEMBER)
  domain          Domain
  avatar          String?
  bio             String?
  github          String?
  linkedin        String?
  portfolio       String?
  points          Int            @default(0)
  tasksCompleted  Int            @default(0)
  streakWeeks     Int            @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tasks           Task[]         @relation("UserTasks")
  evaluationsDone Evaluation[]   @relation("AdminEvaluations")
  sessions        Session[]
}

model Week {
  id                String       @id @default(cuid())
  weekNumber        Int          @unique
  title             String
  theme             String
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean      @default(false)
  promptDescription String?
  createdAt         DateTime     @default(now())

  tasks             Task[]
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation("UserTasks", fields: [userId], references: [id], onDelete: Cascade)
  weekId        String
  week          Week         @relation(fields: [weekId], references: [id])
  domain        Domain
  title         String
  description   String
  githubUrl     String?
  liveUrl       String?
  figmaUrl      String?
  notes         String?
  status        TaskStatus   @default(SUBMITTED)
  submittedAt   DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  evaluation    Evaluation?

  @@index([userId])
  @@index([weekId])
  @@index([status])
}

model Evaluation {
  id              String       @id @default(cuid())
  taskId          String       @unique
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  adminId         String
  admin           User         @relation("AdminEvaluations", fields: [adminId], references: [id])
  score           Int          // 0 to 100
  technicalDepth  Int?         // 0 to 25
  innovation      Int?         // 0 to 25
  completion      Int?         // 0 to 25
  documentation   Int?         // 0 to 25
  feedback        String
  evaluatedAt     DateTime     @default(now())
}

// Server-side login sessions. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// One-time email login codes. Only a hash of the code is stored.
model LoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

// Applications accepted while the Google Sheet was unreachable. Stored until a flush copies them
// to the sheet; the payload is then cleared. Holds the applicant's answers briefly, so access
// to this table should be limited like the sheet itself.
model RecruitmentOutbox {
  id          String    @id @default(cuid())
  reference   String    @unique
  emailHash   String    @unique // sha256 of the normalised email: one application per person
  payload     Json
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  emailSentAt DateTime?
  sentAt      DateTime?

  @@index([sentAt])
}
